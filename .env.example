# --------------
# --- common ---
# --------------

# 실행할 서비스 프로필 설정
# database: 데이터베이스 서버 실행
# redis   : Redis 서버 실행
# prod    : 운영용 백/프론트 이미지 빌드 및 실행
# dev     : 개발용 백/프론트 이미지 빌드 및 실행 (소스코드 변경 시 즉시 반영됨)
COMPOSE_PROFILES=database,redis,dev

# 로그 등 타임존 설정에 사용됨
TZ=Asia/Seoul

# 리눅스 호스트 전용
# 컨테이너 내부 파일 권한 및 프로세스 실행 유저를 호스트 시스템의 사용자와 일치시키기 위해 사용됨
PUID=1000
PGID=1000



# ----------------------
# --- database/cache ---
# ----------------------

# 데이터베이스 루트 계정 패스워드
DB_ROOT_PASS=THIS_IS_A_STRONG_ROOT_PASSWORD

# DB_HOST:
# - IP/도메인은 물론 서비스명/컨테이너명을 호스트로 설정 가능
# - 기본값: `overclock-database`
DB_HOST=overclock-database
DB_PORT=3306  # DB_HOST가 같은 도커 네트워크 내 컨테이너라면 3306으로 고정
DB_USER=overclock
DB_PASS=overclock
DB_NAME=overclock

# redis 연결 설정
REDIS_HOST=overclock-redis
REDIS_PORT=6379  # REDIS_HOST가 같은 도커 네트워크 내 컨테이너라면 6379으로 고정
REDIS_USER=
REDIS_PASS=
REDIS_DB=0



# ------------------------
# --- backend/frontend ---
# ------------------------

# 미설정 시 적용되는 기본값(prod/dev)
# - 백엔드: 8000/8000
# - 프론트엔드: 5173/3000
# - http://localhost:8000 등으로 서비스 접근 가능
BE_PORT=
FE_PORT=

# 프론트엔드에서 백엔드 API 서버로 요청을 보낼 때 사용할 URL
BACKEND_URL="http://localhost:8000"

# 게스트 계정 활성화 여부 및 계정 정보
# 구성 시 백엔드에서 자동으로 게스트 계정이 생성됨
GUEST_LOGIN_ENABLE=true
GUEST_USERNAME=guest
GUEST_EMAIL=guest@example.com
GUEST_PASSWORD=guest

# 백엔드에서 세션 로그인 처리하는 데 필요한 시크릿 키
SECRET_KEY=THIS_IS_A_STRONG_SECRET_KEY

# 프론트엔드에서 카카오 지도 API를 사용할 때 필요한 API 키
KAKAO_MAP_API_KEY="KAKAO_APP_PLATFORM_JAVASCRIPT_KEY"
